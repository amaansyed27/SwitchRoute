# Copy the Web block to apps/web/.env.local.
# Copy the Gateway block to the repository-root .env.

# Web (apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000/v1
GATEWAY_URL=http://localhost:8000

# Gateway (repository-root .env)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Prefer the Supabase Session Pooler connection string for local IPv4 development.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SWITCHROUTE_SECRET_KEY=BASE64_32_BYTE_KEY
SWITCHROUTE_SECRET_KEY_ID=local-v1
SWITCHROUTE_KEY_PEPPER=REPLACE_WITH_LONG_RANDOM_VALUE
WEB_ORIGINS=http://localhost:3000

# Slice 2 hot routing state. Leave unset for deterministic single-process in-memory local state.
# Production should use a standard Redis-compatible managed service.
REDIS_URL=redis://localhost:6379/0

# Optional deterministic E2E provider. Never enable in production.
ENABLE_TEST_PROVIDER=false
