# Web (apps/web)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_SUPABASE_START_OUTPUT
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000/v1
GATEWAY_URL=http://localhost:8000

# Gateway (services/gateway)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_SUPABASE_START_OUTPUT
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SWITCHROUTE_SECRET_KEY=BASE64_32_BYTE_KEY
SWITCHROUTE_SECRET_KEY_ID=local-v1
SWITCHROUTE_KEY_PEPPER=REPLACE_WITH_LONG_RANDOM_VALUE
WEB_ORIGINS=http://localhost:3000

# Optional deterministic E2E provider
ENABLE_TEST_PROVIDER=false
