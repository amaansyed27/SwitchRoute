{
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "additionalProperties": true,
        "properties": {
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "default": "auto",
            "title": "Model",
            "type": "string"
          },
          "stream": {
            "default": false,
            "title": "Stream",
            "type": "boolean"
          }
        },
        "required": [
          "messages"
        ],
        "title": "ChatCompletionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KeyCreate": {
        "properties": {
          "environment": {
            "default": "live",
            "enum": [
              "live",
              "test"
            ],
            "title": "Environment",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "route_id": {
            "format": "uuid",
            "title": "Route Id",
            "type": "string"
          }
        },
        "required": [
          "route_id",
          "name"
        ],
        "title": "KeyCreate",
        "type": "object"
      },
      "ProviderConnectionConfig": {
        "properties": {
          "base_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Url"
          },
          "discover_models": {
            "default": true,
            "title": "Discover Models",
            "type": "boolean"
          },
          "manual_model_id": {
            "anyOf": [
              {
                "maxLength": 240,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manual Model Id"
          }
        },
        "title": "ProviderConnectionConfig",
        "type": "object"
      },
      "ProviderCreate": {
        "properties": {
          "api_key": {
            "maxLength": 2048,
            "minLength": 3,
            "title": "Api Key",
            "type": "string"
          },
          "connection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProviderConnectionConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "provider_kind": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Provider Kind",
            "type": "string"
          }
        },
        "required": [
          "provider_kind",
          "api_key",
          "display_name"
        ],
        "title": "ProviderCreate",
        "type": "object"
      },
      "ProviderCredential": {
        "properties": {
          "api_key": {
            "maxLength": 2048,
            "minLength": 3,
            "title": "Api Key",
            "type": "string"
          },
          "connection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProviderConnectionConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_kind": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Provider Kind",
            "type": "string"
          }
        },
        "required": [
          "provider_kind",
          "api_key"
        ],
        "title": "ProviderCredential",
        "type": "object"
      },
      "RouteTargetInput": {
        "properties": {
          "billing_tier": {
            "default": "unknown",
            "enum": [
              "free",
              "free_capable",
              "paid",
              "unknown"
            ],
            "title": "Billing Tier",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "model_id": {
            "maxLength": 240,
            "minLength": 1,
            "title": "Model Id",
            "type": "string"
          },
          "provider_connection_id": {
            "format": "uuid",
            "title": "Provider Connection Id",
            "type": "string"
          }
        },
        "required": [
          "provider_connection_id",
          "model_id"
        ],
        "title": "RouteTargetInput",
        "type": "object"
      },
      "RouteWrite": {
        "properties": {
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "maxLength": 64,
            "minLength": 2,
            "title": "Slug",
            "type": "string"
          },
          "strategy": {
            "default": "priority",
            "enum": [
              "priority",
              "free_first"
            ],
            "title": "Strategy",
            "type": "string"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/RouteTargetInput"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Targets",
            "type": "array"
          }
        },
        "required": [
          "name",
          "slug",
          "targets"
        ],
        "title": "RouteWrite",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
